# ============================================================
# Smart Building IoT Gateway - Environment Variables
# ============================================================
# Copy file này thành .env và chỉnh sửa:
#   cp .env.example .env

# --- MQTT ---
# ⚠️ TODO [SYNC TV1 + TV2]: Giữ nguyên "mosquitto" — đây là tên service trong docker-compose.yml
# TV1 (sensor/actuator) và TV2 (gateway) phải dùng đúng tên này để kết nối
MQTT_BROKER=mosquitto
MQTT_PORT=1883

# --- Sensor ---
# ⚠️ TODO [SYNC TV1]: Hỏi TV1 xem sensor publish mỗi bao nhiêu giây?
# Nếu TV1 dùng giá trị khác, sửa lại ở đây
PUBLISH_INTERVAL=5

# --- InfluxDB ---
# ⚠️ TODO [SYNC TV2]: TV2 ghi dữ liệu vào InfluxDB với token/org/bucket nào?
# Các giá trị dưới đây PHẢI KHỚP với giá trị TV2 dùng trong iot_gateway/
# Nếu TV2 dùng token khác → sửa INFLUXDB_TOKEN
# Nếu TV2 dùng bucket khác → sửa INFLUXDB_BUCKET
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=admin12345
INFLUXDB_ORG=iot-org
INFLUXDB_BUCKET=smart-building
INFLUXDB_TOKEN=my-super-secret-token

# --- Grafana ---
# ✅ Phần này hoàn toàn do TV3 (bạn) quản lý, không cần sync với ai
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
